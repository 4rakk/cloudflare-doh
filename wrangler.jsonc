{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-doh",
  "main": "_worker.js",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "vars": {
    // 标准 DoH 会优先走 /dns-query
    // 你可以留空，表示只使用标准入口
    "DOH_PATH_PREFIX": "",

    // 逗号分隔的上游 DoH 列表，按顺序故障切换
    "UPSTREAMS": "https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query"

    // 如果你要继续沿用旧仓库的自定义路径映射，也可以在控制台里额外设置：
    // DOMAIN_MAPPINGS = {"\/google":{"targetUrl":"https://dns.google/dns-query","pathMapping":{"\/query-dns":"\/dns-query"}}}
  }
}
